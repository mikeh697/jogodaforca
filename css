@import url('https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap');

body{
    margin-top: 20px;
    background-color: lightskyblue;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
}

#imagem{
    background-image: url("forcainicial.png");
    width: 300px;
    height: 272px;
    background-repeat: no-repeat;
    background-size: 100% 100%;
}

.container{
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    flex-direction: column;
}

#palavraOculta{
    display:flex;
    flex-direction: row;
    justify-content: center;
    margin-top: 40px;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
}

.caracteres{
    width: 35px;
    text-align: center;
    border-bottom: 2px solid #7e0000;
    color: black;
    padding: 2px;
    margin-left: 2px;
    margin-right: 2px;
}

#palavraOculta .caracteres.espaco{
    border: 0 !important;
    border-bottom: 0 !important;
    border-left: 0 !important;
    border-right: 0 !important;
    text-decoration: none !important;
    background: none !important;
    box-shadow: none !important;
    outline: none !important;
    width: 20px; /* Ajuste a largura do espaço aqui se precisar */
    min-width: 20px;
}

#palavraOculta .espaco{
    width: 20px;
    height: 100%;
}

#teclado{
    margin-top: 30px;
}

.letras button{
    width: 50px;
    height: 50px;
    margin: 2px;
    margin-bottom: 5px;
    cursor:pointer;
    box-shadow: 0px 2px 8px dimgray;
    border-radius:5px;
    border: 1px solid dimgray;
    color: red;
    font-weight: 900;
    font-size: 1em;
}

.letras button:disabled{
    cursor: not-allowed;
}

.letras #Reiniciar{
    width:60px;

    font-size: 10px;
}

.letras button:hover{
    transform:scale(2.0);
}

.oculto{
    display: none !important;
}

#mensagem{
    border-radius: 5px;
    position: fixed;
    right:750px;
    bottom:100px;
    background-color: #ffffff;
    padding:20px;
    width: 400px;
    height: 300px;
}
#conteudo{
    font-family:system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif ;
    color:#8b008b;
    display: flex;
    justify-content: center;
}

#titulo{
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
    position: relative;
    left:100px;
}

#texto{
    font-family:system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
    position: relative;
    bottom: -100px;
    right:100px;
}

#palavra{
    position: relative;
    right:10px;
}


#rodape{
    display: flex;
    justify-content: center;
    position: relative;
    bottom: -450px;
    background-color: gold;
    color: #8b008b;
    height: 50px;
}

#dica {
    display:flex;
    justify-content: center;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
}
